      <column caption='Productos Bajo Mínimo' datatype='integer' name='[Calculation_1063693942285348869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [inventario_actual] &lt; [stock_minimo] THEN [producto_stock] END&#13;&#10;)' />
      </column>
      <column caption='Brecha Contra Mínimo' datatype='integer' name='[Calculation_1063693942285447174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stock_minimo]) - SUM([inventario_actual])' />
      </column>
      <column caption='Estado Inventario' datatype='string' name='[Calculation_1063693942285529095]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [inventario_actual] &lt; [stock_minimo] THEN &quot;BAJO MÍNIMO&quot;&#13;&#10;ELSE &quot;EN RANGO&quot;&#13;&#10;END' />
      </column>
