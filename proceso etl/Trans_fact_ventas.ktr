    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>CONN_ROMASA1</connection>
    <sql>SELECT
    fv.id_factura,
    dfv.id_detalle_factura       AS id_detalle_factura_origen,
    DATE(fv.fecha_emision)       AS fecha_emision,
    fv.id_cliente,
    fv.consecutivo_factura,
    dfv.id_producto,
    dfv.cantidad                AS cantidad_vendida,
    COALESCE(dfv.precio_unitario, 0)   AS precio_unitario,
    dfv.subtotal,
    dfv.impuesto,
    COALESCE(dfv.tarifa_impuesto, 0)   AS tarifa_impuesto,
    dfv.total
FROM operacional.factura_venta fv
INNER JOIN operacional.detalle_factura_venta dfv
    ON dfv.id_factura = fv.id_factura
ORDER BY fv.id_factura, dfv.id_detalle_factura;
</sql>
    <limit>0</limit>
    <lookup/>
