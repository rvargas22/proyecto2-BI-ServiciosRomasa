  <step>
    <name>TI_Formula_Base</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>CONN_ROMASA1</connection>
    <sql>SELECT
    f.id_formula                              AS id_formula_origen,
    f.id_producto_terminado                   AS id_producto_terminado_origen,
    UPPER(TRIM(f.nombre_formula))             AS nombre_formula,
    COALESCE(f.version_formula, '1.0')        AS version_formula,
    UPPER(TRIM(p.nombre_producto))            AS producto_terminado,
    f.activa                                  AS activa_formula,
    COALESCE(f.observaciones,
             'Sin observaciones')             AS observaciones_formula,
    DATE(f.fecha_creacion)                    AS fecha_creacion
FROM operacional.formula_alimento f
INNER JOIN operacional.producto p
    ON p.id_producto = f.id_producto_terminado
ORDER BY f.id_formula;
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
