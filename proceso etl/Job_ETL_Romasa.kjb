      <name>SQL_Cliente_No_Identificado</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO dw_romasa.dim_cliente
    (cliente_key, id_cliente_origen, cedula_cliente,
     nombre_cliente, tipo_cliente, activo_cliente,
     fecha_creacion, segmento_cliente)
VALUES
    (0, -1, 'N/A', 'CLIENTE NO IDENTIFICADO',
     'No clasificado', FALSE, CURRENT_DATE, 'NUEVO')
ON CONFLICT (id_cliente_origen) DO NOTHING;</sql>
