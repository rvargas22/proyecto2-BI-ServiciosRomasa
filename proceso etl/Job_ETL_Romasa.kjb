    <entry>
      <name>SQL_Truncate_DW</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE dw_romasa.fact_formula_consumo CASCADE;
TRUNCATE TABLE dw_romasa.fact_inventario_movimientos CASCADE;
TRUNCATE TABLE dw_romasa.fact_ventas CASCADE;
TRUNCATE TABLE dw_romasa.dim_formula CASCADE;
TRUNCATE TABLE dw_romasa.dim_tipo_movimiento CASCADE;
TRUNCATE TABLE dw_romasa.dim_cliente CASCADE;
TRUNCATE TABLE dw_romasa.dim_producto CASCADE;
TRUNCATE TABLE dw_romasa.dim_tiempo CASCADE;
ALTER SEQUENCE dw_romasa.dim_producto_producto_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.dim_cliente_cliente_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.dim_tipo_movimiento_tipo_movimiento_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.dim_formula_formula_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.fact_ventas_venta_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.fact_inventario_movimientos_inventario_movimiento_key_seq RESTART WITH 1;
ALTER SEQUENCE dw_romasa.fact_formula_consumo_formula_consumo_key_seq RESTART WITH 1;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>CONN_ROMASA1</connection>
